DISABLE_HMR=

# Server-side only secrets & configuration for POST /api/contact (Cloudflare Worker / local dev)
# IMPORTANT: Never prefix email API keys with VITE_ and never commit real secrets to Git.
# In production, set RESEND_API_KEY via: npx wrangler secret put RESEND_API_KEY
# For local Wrangler testing, place secrets in .dev.vars (gitignored).
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@urunk.com
CONTACT_FROM_EMAIL="Urunk Website <leads@urunk.com>"
ALLOWED_ORIGINS=https://urunk.com,https://www.urunk.com